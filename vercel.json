{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{app.py,backend/**,frontend/index.html}",
      "excludeFiles": "{tests/**,docs/**,firmware/**,scripts/**,frontend/**}"
    }
  }
}
